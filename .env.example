# Sistema de Calificaciones — XIII Entrada Folklórica Universitaria Nacional Trinidad 2026
# Variables de entorno

# En Supabase: DATABASE_URL usa el pooler transaccional (puerto 6543, pgbouncer)
# y DIRECT_URL la conexión directa (puerto 5432) para migraciones de Prisma.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moperita_nusta_2026
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/moperita_nusta_2026
AUTH_SECRET=change-me-in-production-use-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
EVENT_TIMEZONE=America/La_Paz

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/uploads

SEED_ADMIN_EMAIL=admin@certamen.bo
SEED_ADMIN_PASSWORD=admin2026
